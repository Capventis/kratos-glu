# Glu build of Ory Kratos
# Base images are pinned to exact versions; bump the Go and Alpine tags together.

ARG GO_IMAGE=docker.io/library/golang:1.27.4-alpine3.24
ARG RUNTIME_IMAGE=docker.io/library/alpine:3.24.4

FROM ${GO_IMAGE} AS builder

ARG VERSION=master
ARG COMMIT=undefined
ARG BUILD_DATE=undefined

# Kratos is built with SQLite support, which needs CGO.
RUN apk add --no-cache gcc musl-dev

WORKDIR /go/src/github.com/ory/kratos

COPY go.mod go.sum ./
COPY oryx/go.mod oryx/go.sum ./oryx/
COPY pkg/client-go/go.mod pkg/client-go/go.sum ./pkg/client-go/
RUN go mod download

COPY . .

ENV CGO_ENABLED=1
ENV CGO_CPPFLAGS=-DSQLITE_DEFAULT_FILE_PERMISSIONS=0600
RUN go build -trimpath -buildvcs=false -tags sqlite,hsm,json1 \
      -ldflags "-s -w \
        -X github.com/ory/kratos/driver/config.Version=${VERSION} \
        -X github.com/ory/kratos/driver/config.Commit=${COMMIT} \
        -X github.com/ory/kratos/driver/config.Date=${BUILD_DATE}" \
      -o /usr/bin/kratos .

#########################

FROM ${RUNTIME_IMAGE}

RUN apk upgrade --no-cache && \
    apk add --no-cache ca-certificates && \
    addgroup -S ory && \
    adduser -S ory -G ory -D -u 10000 -h /home/ory -s /bin/nologin && \
    chown -R ory:ory /home/ory && \
    mkdir -p /var/lib/sqlite && \
    chown ory:ory /var/lib/sqlite

WORKDIR /home/ory

COPY --from=builder /usr/bin/kratos /usr/bin/kratos

VOLUME /var/lib/sqlite
VOLUME /home/ory

EXPOSE 4433 4434

USER 10000

ENTRYPOINT ["kratos"]
CMD ["serve"]
